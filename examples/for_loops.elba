// For Loop Examples

println("=== For Loop with Arrays ===");

const numbers: []int = [10, 20, 30, 40, 50];

println("Iterating over array:");
for (num in numbers) {
    println(int_to_str(num));
}

println("");

// Using for loops with arrays of strings
const fruits: []str = ["apple", "banana", "cherry"];
println("Fruit list:");
for (fruit in fruits) {
    const msg: str = str_concat("- ", fruit);
    println(msg);
}

println("");

println("Range loop with continue and break:");
let selected_sum: int = 0;
for (value in 1..=8) {
    if (value == 2) {
        continue;
    }
    if (value == 6) {
        break;
    }
    selected_sum = selected_sum + value;
}
println(str_concat("Selected sum: ", int_to_str(selected_sum)));

println("");

println("Descending range:");
let descending_sum: int = 0;
for (value in 5..=1) {
    if (value == 4) {
        continue;
    }
    if (value == 2) {
        break;
    }
    descending_sum = descending_sum + value;
}
println(str_concat("Descending sum: ", int_to_str(descending_sum)));

println("");
println("=== For Loop Complete! ===");
