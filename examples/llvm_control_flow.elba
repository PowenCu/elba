// LLVM Backend Control Flow Demo
// Demonstrates if-else and while loops with native code compilation

println("=== Elba LLVM Control Flow Demo ===");
println("");

// Example 1: If-Else Expressions
fn max(a: int, b: int) -> int {
    if (a > b) {
        a
    } else {
        b
    }
}

fn min(a: int, b: int) -> int {
    if (a < b) {
        a
    } else {
        b
    }
}

println("If-Else Expressions:");
const max_val: int = max(15, 23);
println(str_concat("max(15, 23) = ", int_to_str(max_val)));

const min_val: int = min(15, 23);
println(str_concat("min(15, 23) = ", int_to_str(min_val)));
println("");

// Example 2: Nested If-Else
fn classify(x: int) -> int {
    if (x < 0) {
        0  // negative
    } else {
        if (x == 0) {
            1  // zero
        } else {
            2  // positive
        }
    }
}

println("Nested If-Else:");
println(str_concat("classify(-5) = ", int_to_str(classify(0 - 5))));
println(str_concat("classify(0) = ", int_to_str(classify(0))));
println(str_concat("classify(5) = ", int_to_str(classify(5))));
println("");

// Example 3: While Loops
fn sum_to_n(n: int) -> int {
    let sum: int = 0;
    let i: int = 1;
    while (i <= n) {
        sum = sum + i;
        i = i + 1;
    }
    sum
}

fn factorial(n: int) -> int {
    let result: int = 1;
    let i: int = 2;
    while (i <= n) {
        result = result * i;
        i = i + 1;
    }
    result
}

println("While Loops:");
const sum_result: int = sum_to_n(10);
println(str_concat("sum(1..10) = ", int_to_str(sum_result)));

const fact_result: int = factorial(6);
println(str_concat("6! = ", int_to_str(fact_result)));
println("");

// Example 4: Combined Control Flow
fn fibonacci(n: int) -> int {
    if (n <= 1) {
        n
    } else {
        let a: int = 0;
        let b: int = 1;
        let i: int = 2;
        while (i <= n) {
            const temp: int = a + b;
            a = b;
            b = temp;
            i = i + 1;
        }
        b
    }
}

println("Combined If-Else and While:");
println(str_concat("fibonacci(10) = ", int_to_str(fibonacci(10))));
println("");

println("=== All Tests Passed! ===");
