// Comprehensive LLVM Backend Control Flow Test Suite
// Tests all control flow features with various edge cases

// Test 1: Simple if-else
fn abs(x: int) -> int {
    if (x < 0) {
        0 - x
    } else {
        x
    }
}

// Test 2: Nested if-else
fn sign(x: int) -> int {
    if (x < 0) {
        0 - 1
    } else {
        if (x > 0) {
            1
        } else {
            0
        }
    }
}

// Test 3: While loop with counter
fn sumUpTo(n: int) -> int {
    let sum: int = 0;
    let i: int = 1;
    while (i <= n) {
        sum = sum + i;
        i = i + 1;
    }
    sum
}

// Test 4: While loop with break condition
fn findFirst(target: int, limit: int) -> int {
    let i: int = 0;
    while (i < limit) {
        if (i * i == target) {
            return i;
        }
        i = i + 1;
    }
    0 - 1  // Not found
}

// Test 5: Complex nested control flow
fn collatz(n: int) -> int {
    let steps: int = 0;
    let current: int = n;
    while (current > 1) {
        if (current % 2 == 0) {
            current = current / 2;
        } else {
            current = (current * 3) + 1;
        }
        steps = steps + 1;
    }
    steps
}

// Test 6: Multiple sequential if-else
fn grade(score: int) -> int {
    if (score >= 90) {
        4  // A
    } else {
        if (score >= 80) {
            3  // B
        } else {
            if (score >= 70) {
                2  // C
            } else {
                if (score >= 60) {
                    1  // D
                } else {
                    0  // F
                }
            }
        }
    }
}

println("=== LLVM Backend Control Flow Test Suite ===");
println("");

