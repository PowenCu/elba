// Match Statements - IMPLEMENTED
fn match_example(x: int) -> str {
    match (x) {
        1 => "One",
        2 => "Two",
        3 => "Three",
        _ => "Unknown"
    }
}

const match1: str = match_example(1);
const match2: str = match_example(3);